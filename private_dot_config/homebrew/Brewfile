# ==============================================================================
# BREW FORMULAE (CLI Tools & Utilities)
# ==============================================================================

# Core System & Modern CLI Upgrades
brew "bat"            # Syntax highlighting for cat
brew "chezmoi"        # Dotfile manager
brew "duf"            # Disk usage/space utility (modern replacement for df)
brew "eza"            # Modern replacement for ls
brew "fzf"            # Command-line fuzzy finder
brew "gh"             # GitHub CLI
brew "git"            # Distributed version control system
brew "git-delta"      # Syntax-highlighting pager for git
brew "jq"             # Command-line JSON processor
brew "lazygit"        # Simple terminal UI for git commands
brew "ripgrep"        # Fast search tool (like grep)
brew "thefuck"        # Programmatically correct mistyped commands
brew "tldr"           # Simplified and community-driven man pages
brew "tree"           # Display directories as trees
brew "wget"           # Retrieve files from the web
brew "zoxide"         # Smart directory jumper that learns your habits

# Security & Encryption
brew "gnupg"          # GNU Privacy Guard
brew "pinentry-mac"   # Native macOS dialog for GPG passphrases

# Universal Version Manager (Replaces rbenv, pyenv, nvm)
brew "asdf"

# Modern Rails Development Tools
brew "direnv"         # Environment variable manager (used by Rails bin/dev)
brew "overmind"       # Elite process manager for bin/dev (pry-debugging friendly)
brew "tmux"           # Terminal multiplexer (required for Overmind)
brew "vips"           # Fast image processing library (used by Rails ActiveStorage)

# Kubernetes Dev Tools
brew "helm"           # Kubernetes package manager
brew "kubectl"        # Kubernetes command-line tool
brew "k9s"            # Terminal UI for managing Kubernetes clusters
brew "lazydocker"     # Terminal UI for managing Docker containers

# Development Environments & Databases
brew "postgresql@17"  # Relational database (essential for Rails)
brew "redis"          # In-memory key-value store
brew "awscli"         # Amazon Web Services command-line interface

# Text Editors
brew "helix"          # Modern modal text editor
brew "neovim"         # Highly extensible Vim fork

# ==============================================================================
# CASKS (GUI Applications & Fonts)
# ==============================================================================

# Utilities & Window Management
cask "alfred"         # Application launcher and productivity search
cask "bartender"      # Menu bar organizer
cask "itsycal"        # Menu bar calendar
cask "kap"            # Screen recording and GIF creation
cask "rectangle"      # Window resizing shortcuts

# Security
cask "1password"      # Password manager
cask "1password-cli"  # Command-line interface for 1Password

# Communication
cask "discord"        # Gaming & community chat
cask "slack"          # Communication client

# Terminal & Dev Tools
cask "bruno"              # Open source IDE for exploring and testing APIs
cask "ghostty"            # Modern native GPU-accelerated terminal
cask "jetbrains-toolbox"  # Manager for RubyMine/JetBrains IDEs
cask "ngrok"              # Secure tunnels to localhost
cask "rancher"            # Kubernetes management GUI

# Browsers
cask "google-chrome"
cask "firefox@developer-edition"

# Media & Leisure
cask "steam"           # Gaming platform
cask "calibre"         # eBook management software

# Elite QuickLook Plugins
cask "suspicious-package" # Preview package installer contents
cask "qlstephen"          # Preview extensionless text files (e.g. Gemfiles)

# Typography (Developer Nerd Fonts)
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
