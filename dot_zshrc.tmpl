# ==============================================================================
# 💻 1. SYSTEM INITIALIZATION & ENVIRONMENT
# ==============================================================================

# Initialize Homebrew on Apple Silicon
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Prepend personal binaries
export PATH="$HOME/.local/bin:$PATH"

# Editor & System Defaults
export EDITOR="hx"
export VISUAL="hx"
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ==============================================================================
# 🐚 2. OH MY ZSH SETUP
# ==============================================================================

# Base OMZ Paths
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh"

# Theme Choice
ZSH_THEME="superjarin"

# Behavior Flags
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13
COMPLETION_WAITING_DOTS="%F{pink}working on it...%f"
HIST_STAMPS="mm.dd.yyyy"

# Curated Plugins
plugins=(
    # Version Control
    gh
    git

    # Infrastructure
    docker
    docker-compose
    kubectl
    aws

    # Runtimes & Tooling
    bundler
    dotenv
    ngrok
    pip
    postgres
    python
    rails
    rake
    yarn

    # CLI Utilities
    brew
    chezmoi
    macos
    zsh-bat
    1password

    # Productivity
    copypath
    thefuck

    # Community Plugins (Must be at the end)
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Performance Tuning
export ZSH_AUTOSUGGEST_USE_ASYNC=1

# ==============================================================================
# ⚡ 3. RUNTIME MANAGERS (MUST LOAD LAST)
# ==============================================================================

# Activate mise shims after PATH modifications
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi

# direnv
eval "$(direnv hook zsh)"

{{- if and (hasKey . "dev") .dev }}
# Zulu JDK 17 (dev profile)
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
{{- end }}

{{- if and (hasKey . "prizepicks") .prizepicks }}
# prizepicks-devenv: run commands in the matching container
alias p="$HOME/Code/7Factor/PrizePicks/prizepicks-devenv/scripts/run_in_container"
alias dve="$HOME/Code/7Factor/PrizePicks/prizepicks-devenv/scripts/run_in_container"

# prizepicks-devenv: once a day, offer to sync the repos (scripts/sync_repos)
_devenv_sync_prompt() {
  local dir="$HOME/Code/7Factor/PrizePicks/prizepicks-devenv"
  local stamp="$HOME/.cache/devenv-sync-prompted" today=$(date +%F)
  [[ -o interactive && -t 0 && -x "$dir/scripts/sync_repos" ]] || return
  [[ "$(cat "$stamp" 2>/dev/null)" == "$today" ]] && return
  [[ "$(stat -f %Sm -t %F "$dir/.sync_state" 2>/dev/null)" == "$today" ]] && return
  mkdir -p "${stamp:h}" && echo "$today" > "$stamp"
  read -q "REPLY?Devenv repos not synced today. Sync now? [y/N] " && { echo; "$dir/scripts/sync_repos"; } || echo
}
_devenv_sync_prompt
{{- end }}
