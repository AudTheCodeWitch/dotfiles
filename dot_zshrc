# ==============================================================================
# 💻 1. SYSTEM INITIALIZATION (MUST BE AT THE TOP)
# ==============================================================================

# Initialize Homebrew on Apple Silicon first so all plugins can find their tools
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Prepend your personal local binaries so they take absolute priority
export PATH="$HOME/.local/bin:$PATH"

# Set default text editors (Helix)
export EDITOR="hx"
export VISUAL="hx"

# Language Environment
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ==============================================================================
# 🐚 2. OH MY ZSH SETUP
# ==============================================================================

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme Choice
ZSH_THEME="superjarin"

# Clean UI & Behavior Options
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13
COMPLETION_WAITING_DOTS="%F{pink}working on it...%f"
HIST_STAMPS="mm.dd.yyyy"

# Curated Plugins List (Note: removed old 'z' plugin since 'zoxide' replaces it)
plugins=(
    # Version Control
    gh
    git

    # Cloud & Infrastructure
    docker
    docker-compose
    kubectl
    aws

    # Programming Languages & Tools
    asdf
    bundler
    dotenv
    ngrok
    pip
    postgres
    python
    rails
    rake
    yarn

    # System & CLI Utilities
    brew
    chezmoi
    macos
    zsh-bat
    1password

    # Productivity Boosters
    copypath
    thefuck

    # Community Plugins (must be last)
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# 👇 THE ELITE FIX: Route Oh My Zsh custom loads to your clean config folder
export ZSH_CUSTOM="$HOME/.config/zsh"

# Load Oh My Zsh!
# (This step automatically handles loading your new aliases.zsh and tools.zsh!)
source $ZSH/oh-my-zsh.sh

# Force Zsh autosuggestions to run asynchronously (stops typing stutter)
export ZSH_AUTOSUGGEST_USE_ASYNC=1
