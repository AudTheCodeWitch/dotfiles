# Editor Configuration (Helix as primary diff & merge tool)
[edit]
    command = "hx"

[diff]
    command = "hx"
    args = ["--diff"]
    pager = "bat --paging=never"

[merge]
    command = "hx"

# Global Pager Configuration
pager = "bat"

# External Secret Manager / Custom Data Variables
[data]
    secret_manager_cli = "op"  # Generic placeholder (e.g., 1Password 'op', 'bw', or custom script)
    secret_vault = "Personal"

# Machine profile, asked once per machine/user at `chezmoi init`.
# Profiles are layered: base < dev < prizepicks (each includes the ones before it).
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "base" "dev" "prizepicks") "base" }}
    profile = {{ $profile | quote }}
    dev = {{ or (eq $profile "dev") (eq $profile "prizepicks") }}
    prizepicks = {{ eq $profile "prizepicks" }}
